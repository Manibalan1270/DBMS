// main.jsx
import React from 'react';
import ReactDOM from 'react-dom/client';
import App from './App.jsx';
import { UserContextProvider } from './context/UserContext.jsx';
ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <UserContextProvider>
      <App />
    </UserContextProvider>
  </React.StrictMode>
);

// App.jsx
import { BrowserRouter, Routes, Route } from 'react-router-dom';
import Home from './pages/Home.jsx';
import Register from './pages/Register.jsx';
import Login from './pages/Login.jsx';
import Profile from './pages/Profile.jsx';
import AdminView from './pages/AdminView.jsx';
import UserDetails from './pages/UserDetails.jsx';
import EditUser from './pages/EditUser.jsx';
import ResetPassword from './pages/ResetPassword.jsx';
function App() {
  return (
    <BrowserRouter>
      <Routes>
        <Route path="/" element={<Home />} />
        <Route path="/register" element={<Register />} />
        <Route path="/login" element={<Login />} />
        <Route path="/profile" element={<Profile />} />
        <Route path="/reset-password" element={<ResetPassword />} />
        <Route path="/admin" element={<AdminView />} />
        <Route path="/admin/user/:id" element={<UserDetails />} />
        <Route path="/admin/edit/:id" element={<EditUser />} />
      </Routes>
    </BrowserRouter>
  );
}
export default App;

// context/UserContext.jsx
import { createContext, useState } from 'react';
export const UserContext = createContext();
export const UserContextProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  return <UserContext.Provider value={{ user, setUser }}>{children}</UserContext.Provider>;
};

// pages/Register.jsx
import { useState } from 'react';
import axios from 'axios';
export default function Register() {
  const [name,setName]=useState('');
  const [email,setEmail]=useState('');
  const [password,setPassword]=useState('');
  const handleSubmit=async()=>{
    try{
      const res=await axios.post('http://localhost:5000/register',{name,email,password});
      alert(res.data.message);
    }catch(err){alert(err.response.data.message);}
  };
  return (
    <div>
      <h1>Register</h1>
      <input placeholder="Name" value={name} onChange={e=>setName(e.target.value)}/>
      <input placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)}/>
      <input placeholder="Password" type="password" value={password} onChange={e=>setPassword(e.target.value)}/>
      <button onClick={handleSubmit}>Register</button>
    </div>
  );
}

// pages/Login.jsx
import { useState, useContext } from 'react';
import axios from 'axios';
import { UserContext } from '../context/UserContext.jsx';
export default function Login() {
  const [email,setEmail]=useState('');
  const [password,setPassword]=useState('');
  const { setUser } = useContext(UserContext);
  const handleLogin=async()=>{
    try{
      const res=await axios.post('http://localhost:5000/login',{email,password});
      setUser(res.data.user);
      alert("Login Successful");
    }catch(err){alert(err.response.data.message);}
  };
  return (
    <div>
      <h1>Login</h1>
      <input placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)}/>
      <input placeholder="Password" type="password" value={password} onChange={e=>setPassword(e.target.value)}/>
      <button onClick={handleLogin}>Login</button>
    </div>
  );
}

// pages/Profile.jsx
import { useContext,useEffect,useState } from 'react';
import { UserContext } from '../context/UserContext.jsx';
import axios from 'axios';
export default function Profile() {
  const { user } = useContext(UserContext);
  const [info,setInfo]=useState(null);
  useEffect(()=>{
    const fetchProfile=async()=>{const res=await axios.get(`http://localhost:5000/user/${user?.id}`); setInfo(res.data);}
    if(user) fetchProfile();
  },[user]);
  if(!user) return <p>Login first</p>;
  return (<div><h1>{info?.name}'s Profile</h1><p>Email: {info?.email}</p></div>);
}

// pages/ResetPassword.jsx
import { useState } from 'react';
import axios from 'axios';
export default function ResetPassword() {
  const [email,setEmail]=useState('');
  const [newPass,setNewPass]=useState('');
  const handleReset=async()=>{await axios.put('http://localhost:5000/reset-password',{email,password:newPass}); alert("Password Reset Success");};
  return (<div><h1>Reset Password</h1><input placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)}/><input placeholder="New Password" value={newPass} onChange={e=>setNewPass(e.target.value)}/><button onClick={handleReset}>Reset</button></div>);
}

// pages/AdminView.jsx
import { useEffect,useState } from 'react';
import axios from 'axios';
import { Link } from 'react-router-dom';
export default function AdminView() {
  const [users,setUsers]=useState([]);
  useEffect(()=>{const fetchUsers=async()=>{const res=await axios.get('http://localhost:5000/admin/users'); setUsers(res.data);} ;fetchUsers();},[]);
  const deleteUser=async(id)=>{await axios.delete(`http://localhost:5000/admin/delete/${id}`); setUsers(users.filter(u=>u.id!==id));};
  return (<div><h1>All Users</h1>{users.map(u=><div key={u.id}>{u.name} - {u.email} <Link to={`/admin/user/${u.id}`}>View</Link> <Link to={`/admin/edit/${u.id}`}>Edit</Link> <button onClick={()=>deleteUser(u.id)}>Delete</button></div>)}</div>);
}

// pages/UserDetails.jsx
import { useState,useEffect } from 'react';
import axios from 'axios';
import { useParams } from 'react-router-dom';
export default function UserDetails() {
  const { id } = useParams();
  const [user,setUser]=useState(null);
  useEffect(()=>{const fetchUser=async()=>{const res=await axios.get(`http://localhost:5000/admin/user/${id}`); setUser(res.data);} ;fetchUser();},[id]);
  if(!user) return <p>Loading...</p>;
  return (<div><h1>{user.name}</h1><p>Email: {user.email}</p><p>ID: {user.id}</p></div>);
}

// pages/EditUser.jsx
import { useState,useEffect } from 'react';
import axios from 'axios';
import { useParams,useNavigate } from 'react-router-dom';
export default function EditUser() {
  const { id } = useParams();
  const navigate=useNavigate();
  const [name,setName]=useState(''); const [email,setEmail]=useState('');
  useEffect(()=>{const fetchUser=async()=>{const res=await axios.get(`http://localhost:5000/admin/user/${id}`); setName(res.data.name); setEmail(res.data.email);} ;fetchUser();},[id]);
  const handleEdit=async()=>{await axios.put(`http://localhost:5000/admin/edit/${id}`,{name,email}); navigate('/admin');};
  return (<div><h1>Edit User</h1><input value={name} onChange={e=>setName(e.target.value)}/><input value={email} onChange={e=>setEmail(e.target.value)}/><button onClick={handleEdit}>Save</button></div>);
}

// backend/index.js
const express=require('express');
const mysql=require('mysql2');
const cors=require('cors');
const bcrypt=require('bcryptjs');
const app=express();
app.use(express.json());
app.use(cors());
const db=mysql.createPool({host:'localhost',user:'root',password:'',database:'user_system'});
app.post('/register',(req,res)=>{const {name,email,password}=req.body; const hash=bcrypt.hashSync(password,8); db.query('INSERT INTO users(name,email,password,role) VALUES(?,?,?,?)',[name,email,hash,'user'],(err)=>{if(err){if(err.code==='ER_DUP_ENTRY') return res.status(400).json({message:'Email exists'}); return res.status(500).json({message:'DB error'});} res.json({message:'Registration successful'});});});
app.post('/login',(req,res)=>{const {email,password}=req.body; db.query('SELECT * FROM users WHERE email=?',[email],(err,result)=>{if(err||result.length===0) return res.status(400).json({message:'Invalid email or password'}); const valid=bcrypt.compareSync(password,result[0].password); if(!valid) return res.status(400).json({message:'Incorrect password'}); res.json({message:'Login success', user:{id:result[0].id,name:result[0].name,email:result[0].email,role:result[0].role}});});});
app.get('/user/:id',(req,res)=>{db.query('SELECT id,name,email,role FROM users WHERE id=?',[req.params.id],(err,result)=>{if(err) return res.status(500).json({});res.json(result[0]);});});
app.put('/reset-password',(req,res)=>{const {email,password}=req.body; const hash=bcrypt.hashSync(password,8); db.query('UPDATE users SET password=? WHERE email=?',[hash,email],(err)=>{if(err) return res.status(500).json({}); res.json({message:'Password updated'});});});
app.get('/admin/users',(req,res)=>{db.query('SELECT id,name,email,role FROM users',(err,result)=>{if(err) return res.status(500).json({}); res.json(result);});});
app.get('/admin/user/:id',(req,res)=>{db.query('SELECT id,name,email,role FROM users WHERE id=?',[req.params.id],(err,result)=>{if(err) return res.status(500).json({}); res.json(result[0]);});});
app.put('/admin/edit/:id',(req,res)=>{const {name,email}=req.body; db.query('UPDATE users SET name=?,email=? WHERE id=?',[name,email,req.params.id],(err)=>{if(err) return res.status(500).json({}); res.json({message:'Updated'});});});
app.delete('/admin/delete/:id',(req,res)=>{db.query('DELETE FROM users WHERE id=?',[req.params.id],(err)=>{if(err) return res.status(500).json({}); res.json({message:'Deleted'});});});
app.listen(5000,()=>console.log("Server running at 5000"));

// MySQL
CREATE DATABASE user_system;
USE user_system;
CREATE TABLE users(
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100),
  email VARCHAR(100) UNIQUE,
  password VARCHAR(255),
  role VARCHAR(20) DEFAULT 'user'
);
